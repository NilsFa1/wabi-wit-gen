<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Wabi C# SDK = code generated by wabi-wit-gen from client.wit, incl. the runtime (generated/csharp/Runtime).
    Neither part references a particular core implementation: the native library
    (Rust, Go, Zig, ...) is resolved at run time as "wabi_client"
    (or from $WABI_NATIVE_LIB).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Wabi.Client</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../generated/csharp/**/*.cs" LinkBase="Generated" />
  </ItemGroup>
</Project>
