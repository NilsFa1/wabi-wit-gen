<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Acme C# SDK = hand-written generic runtime + code generated from client.wit.
    Neither part references a particular core implementation: the native library
    (Rust, Go, Zig, ...) is resolved at run time as "acme_client"
    (or from $ACME_NATIVE_LIB).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Acme.Client</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../runtime/csharp/**/*.cs" LinkBase="Runtime" />
    <Compile Include="../../../generated/csharp/**/*.cs" LinkBase="Generated" />
  </ItemGroup>
</Project>
