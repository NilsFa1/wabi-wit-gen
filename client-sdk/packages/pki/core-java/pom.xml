<?xml version="1.0" encoding="UTF-8"?>
<!--
  gematik:pki PoC core in Java: a small wrapper around gematik ref-GemLibPki
  (TUC_PKI_018), compiled with GraalVM native-image into libgematik_pki.so.

    mvn -B verify                 compile + JVM tests (plain JDK 21+)
    ./build-native.sh             native shared library (needs GraalVM 21+, see README.md)

  Sources compiled into the core:
    src/main/java                 hand-written business logic (Core, GemLibPkiVerifier)
    src/generated/java            acme-wit-gen `java-core` target (dispatcher, interfaces)
    ../../../runtime/java-core    generic Java core runtime (+ GraalVM entry points)
    ../generated/java (subset)    contract types + codec shared with the Java SDK
    ../../../runtime/java (subset) MessagePack + exception base classes
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.gematik.example</groupId>
  <artifactId>gematik-pki-core</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <version.gemlibpki>0.9.3</version.gemlibpki>
    <version.graal-sdk>23.1.2</version.graal-sdk>
    <version.junit>5.10.2</version.junit>
    <sdk.sources>${project.build.directory}/generated-sources/sdk</sdk.sources>
  </properties>

  <dependencies>
    <dependency>
      <groupId>de.gematik.pki.gemlibpki</groupId>
      <artifactId>gemLibPki</artifactId>
      <version>${version.gemlibpki}</version>
      <!-- xades4j brings BouncyCastle 1.70 (jdk15on) next to gemLibPki's 1.71.1 (jdk18on):
           same packages twice, with different jar signers. Keep only the newer one. -->
      <exclusions>
        <exclusion><groupId>org.bouncycastle</groupId><artifactId>bcpkix-jdk15on</artifactId></exclusion>
        <exclusion><groupId>org.bouncycastle</groupId><artifactId>bcprov-jdk15on</artifactId></exclusion>
        <exclusion><groupId>org.bouncycastle</groupId><artifactId>bcutil-jdk15on</artifactId></exclusion>
      </exclusions>
    </dependency>
    <!-- @CEntryPoint & co.; provided by native-image at build time -->
    <dependency>
      <groupId>org.graalvm.sdk</groupId>
      <artifactId>graal-sdk</artifactId>
      <version>${version.graal-sdk}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${version.junit}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Pull in the parts of the Java SDK the core shares (types, codec, MessagePack). -->
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>sdk-contract-types</id>
            <phase>generate-sources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${sdk.sources}</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../generated/java</directory>
                  <includes><include>com/gematik/pki/**/*.java</include></includes>
                  <!-- the SDK client class talks to a native core; the core does not need it -->
                  <excludes><exclude>com/gematik/pki/CertificateVerifier.java</exclude></excludes>
                </resource>
                <resource>
                  <directory>${project.basedir}/../../../runtime/java</directory>
                  <includes>
                    <include>com/acme/client/runtime/MsgPack*.java</include>
                    <include>com/acme/client/runtime/Acme*Exception.java</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>${project.basedir}/src/generated/java</source>
                <source>${project.basedir}/../../../runtime/java-core/src</source>
                <source>${sdk.sources}</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs><arg>-Xlint:all,-serial,-processing,-options</arg></compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.1</version>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Experiment: the same core as a shared library for Android / iOS with Gluon
      Substrate + Gluon's GraalVM (see build-mobile.sh). Not part of the normal build.
        mvn -Pmobile package gluonfx:sharedlib -Dgluonfx.target=android|ios
    -->
    <profile>
      <id>mobile</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.gluonhq</groupId>
            <artifactId>gluonfx-maven-plugin</artifactId>
            <version>1.0.24</version><!-- Substrate 0.0.64: matches the newest public Gluon GraalVM (23+25.1-dev, 2024-09) -->
            <configuration>
              <!-- no main method is run: the library is entered through the @CEntryPoint functions -->
              <mainClass>acme.core.runtime.SharedLibMain</mainClass>
              <nativeImageArgs>
                <arg>-H:+ReportExceptionStackTraces</arg>
                <arg>--enable-url-protocols=http</arg>
                <!-- GraalVM 23 finds a SAX locator in the image heap (JAXB/XML setup at build time) -->
                <arg>--initialize-at-build-time=org.xml.sax.helpers.LocatorImpl</arg>
              </nativeImageArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
