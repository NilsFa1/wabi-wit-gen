<Project Sdk="Microsoft.NET.Sdk">
  <!--
    gematik:pki PoC SDK = code generated by wabi-wit-gen (runtime: namespace Gematik.Pki.Runtime) from
    packages/pki/wit/pki.wit. The native core (Java + gemLibPki, GraalVM) is resolved at run
    time as "gematik_pki" (or from $WABI_NATIVE_LIB).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Gematik.Pki</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../generated/csharp/**/*.cs" LinkBase="Generated" />
  </ItemGroup>
</Project>
