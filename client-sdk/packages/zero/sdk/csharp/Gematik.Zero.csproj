<Project Sdk="Microsoft.NET.Sdk">
  <!--
    gematik:zero PoC SDK = code generated by wabi-wit-gen (runtime: namespace Gematik.Zero.Runtime) from
    packages/zero/wit/zero.wit. The native core (Go + libzero) is resolved at run
    time as "gematik_zero" (or from $WABI_NATIVE_LIB).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Gematik.Zero</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../generated/csharp/**/*.cs" LinkBase="Generated" />
  </ItemGroup>
</Project>
