/// PoC: a very small slice of gematik zero-lab (libzero) as a cross-language SDK.
///
/// The CORE (Go, using libzero + lestrrat-go/jwx) builds RFC 9449 DPoP proofs.
/// The private key never leaves the APP: the core asks the app to sign through
/// the imported interface `host-keys` (ABI 1.1 host calls), so the app can keep
/// the key in the Secure Enclave, Android Keystore, a TPM or an HSM.
package gematik:zero@0.1.0;

interface types {
    /// Every error a zero operation can fail with.
    variant zero-error {
        /// The app does not know the requested key.
        key-not-found(string),
        /// Signing or key parsing failed.
        crypto(string),
        /// An argument was rejected.
        invalid-input(string),
    }
}

/// Implemented by the APP, called by the core.
interface host-keys {
    use types.{zero-error};

    /// SubjectPublicKeyInfo (DER) of the EC P-256 key `key-id`.
    public-key: func(key-id: string) -> result<list<u8>, zero-error>;

    /// ECDSA P-256 signature (ASN.1 DER, as platform keystores return it)
    /// over the given SHA-256 digest.
    sign: func(key-id: string, digest: list<u8>) -> result<list<u8>, zero-error>;
}

/// Implemented by the core, used by the app.
interface dpop {
    use types.{zero-error};

    /// Creates DPoP proofs (RFC 9449) with an app-held key.
    resource dpop-signer {
        constructor(key-id: string);

        /// RFC 7638 JWK thumbprint (SHA-256, base64url) of the key, e.g. for
        /// `dpop_jkt` in the authorization request.
        thumbprint: async func() -> result<string, zero-error>;

        /// Signed DPoP proof JWT for one HTTP request. `access-token` adds the
        /// `ath` claim, `nonce` a server-provided DPoP nonce.
        create-proof: async func(http-method: string, http-url: string, access-token: option<string>, nonce: option<string>) -> result<string, zero-error>;
    }
}

world zero-sdk {
    import host-keys;
    export dpop;
}
