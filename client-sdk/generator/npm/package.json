{
  "name": "@nfails/wabi-wit-gen",
  "version": "0.1.0",
  "description": "WIT → SDKs (C#, Java/Android, Swift, Dart/Flutter, TypeScript/Bun) + core glue (Rust, Go, C#, Java) over one stable native ABI. Runs as WebAssembly: no native install.",
  "keywords": [
    "wit",
    "component-model",
    "ffi",
    "codegen",
    "sdk",
    "native-abi",
    "flutter",
    "jni",
    "swift",
    "bun"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NilsFa1/UniWtiGen.git",
    "directory": "client-sdk/generator/npm"
  },
  "type": "module",
  "bin": {
    "wabi-wit-gen": "bin/wabi-wit-gen.mjs"
  },
  "files": [
    "bin/",
    "wabi-wit-gen.wasm",
    "README.md",
    "LICENSE",
    "NOTICE",
    "example/README.md",
    "example/wit/greeter.wit",
    "example/core/Cargo.toml",
    "example/core/src/",
    "example/app.ts",
    "example/dart_app/pubspec.yaml",
    "example/dart_app/bin/",
    "example/dotnet_app/Program.cs",
    "example/dotnet_app/dotnet_app.csproj",
    "example/dotnet_app/nuget.config"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  },
  "scripts": {
    "build": "./build.sh",
    "test": "./test.sh"
  },
  "publishConfig": {
    "access": "public"
  }
}
