<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A core written in C#, compiled ahead-of-time to a plain native shared
    library (libwabi_client.so / wabi_client.dll / .dylib) that exports the
    Wabi native ABI. No .NET runtime needs to be installed on the host; the
    SDKs (C#, Java, Dart, Swift) cannot tell it apart from the Rust core.

      dotnet publish -c Release -r linux-x64   →  bin/Release/net8.0/linux-x64/publish/wabi_client.so
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AssemblyName>wabi_client</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <!-- Generated by wabi-wit-gen (target csharp-core): exports prefix, dispatch, interfaces, import clients. -->
    <Compile Include="generated/*.g.cs" />
    <!-- Contract-agnostic C# core runtime (handles, futures, streams, generic exports). -->
    <Compile Include="../../runtime/csharp-core/CoreAbi.cs" LinkBase="Runtime" />
    <!-- Reused from the SDK side: the generated contract types + codec and the MessagePack runtime. -->
    <Compile Include="../../generated/csharp/Types.g.cs" LinkBase="Contract" />
    <Compile Include="../../generated/csharp/WireCodec.g.cs" LinkBase="Contract" />
    <Compile Include="../../generated/csharp/Runtime/MsgPack.cs" LinkBase="Contract" />
    <Compile Include="../../generated/csharp/Runtime/Exceptions.cs" LinkBase="Contract" />
  </ItemGroup>
</Project>
