<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The example core in C#, compiled ahead-of-time to a plain native shared
    library (libdemo_client.so / demo_client.dll / .dylib) that exports the
    Wabi native ABI. No .NET runtime needs to be installed on the host; the
    SDKs (C#, Java, Swift, Dart, TypeScript) cannot tell it apart from the Rust core.

      dotnet publish -c Release -r linux-x64 -o out   →  out/demo_client.so
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AssemblyName>demo_client</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <!-- Generated by wabi-wit-gen (target csharp-core): exports prefix, dispatch, interfaces, import clients. -->
    <Compile Include="../sdk/core-csharp/generated/*.g.cs" LinkBase="Generated" />
    <!-- Contract-agnostic C# core runtime (handles, futures, streams, generic exports, host calls). -->
    <Compile Include="../sdk/core-csharp/runtime/*.cs" LinkBase="Runtime" />
    <!-- Reused from the SDK side: the generated contract types + codec and the MessagePack runtime. -->
    <Compile Include="../sdk/csharp/Types.g.cs" LinkBase="Contract" />
    <Compile Include="../sdk/csharp/WireCodec.g.cs" LinkBase="Contract" />
    <Compile Include="../sdk/csharp/Runtime/MsgPack.cs" LinkBase="Contract" />
    <Compile Include="../sdk/csharp/Runtime/Exceptions.cs" LinkBase="Contract" />
  </ItemGroup>
</Project>
